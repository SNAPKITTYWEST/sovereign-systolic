# dft_scan.ys — DFT / Scan Insertion Script
# Yosys + custom (open-source approximation)

read_verilog -sv tensor_array.sv
hierarchy -top systolic_array_16x16

# Basic synthesis first
proc; opt; memory; opt; techmap; opt

# ABC mapping
abc -liberty sky130_fd_sc_hd.lib
clean

# Write scan-ready netlist
write_verilog tensor_array_scan.v

puts "DFT: Basic scan-ready netlist written."
puts "For production tape-out use commercial DFT (TetraMAX / Modus / etc.)"
